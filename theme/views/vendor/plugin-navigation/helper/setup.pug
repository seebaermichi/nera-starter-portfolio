each item, index in elements || app.nav.elements || []
  - const isActive = item.href === meta.fullPath
  //- Class names come from config/navigation.yaml via app.nav, falling back to
  //- the BEM defaults so an unconfigured site renders exactly as before.
  - const activeClass = isActive ? ((app.nav && app.nav.activeClass) || 'nav__link--active') : ''
  //- The directory that counts as the site root. Defaults to '/', but a site
  //- that prefixes its pages — a language prefix such as /de, a subdirectory
  //- deployment — passes its own through the mixin's `rootPath` argument.
  - const navRoot = (typeof rootPath !== 'undefined' && rootPath) || '/'
  //- The section an entry stands for: the directory its own href lives in.
  - const itemDir = item.href.replace(/\/[^/]*$/, '') || '/'
  //- Only an entry pointing at a directory's index (`/about/index.html` or
  //- `/about/`) stands for a section. A link to a single page such as
  //- `/about/me.html` would otherwise be marked on every other page in /about,
  //- the section index included.
  - const isSection = /\/(index\.html)?$/.test(item.href)
  //- An entry is an ancestor of the current page when that page sits inside
  //- the entry's section — either directly in it, or further down. Asking the
  //- reverse, whether the entry sits inside the current page's directory,
  //- holds only for pages exactly one level deep: a page at
  //- /tutorials/tags/links.html would not match /tutorials/index.html.
  //- Entries living in the root are never ancestors, since every page is
  //- inside the root and Home would otherwise be marked on every page.
  - const isParent = isSection && itemDir !== navRoot && (meta.dirname === itemDir || meta.dirname.indexOf(itemDir + '/') === 0)
  - const activePathClass = !isActive && isParent ? ((app.nav && app.nav.activePathClass) || 'nav__link--active-path') : ''
